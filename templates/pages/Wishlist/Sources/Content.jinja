{#def
    result: QueryResult,
#}

{% set book_id = result.book.id if result.book.id is defined else result.book.asin %}
{% set is_manual = result.book.id is defined %}

<div class="w-full p-4 sm:p-6 lg:p-8 flex flex-col gap-2" id="sources">
    <a preload
       href="{{ base_url }}/wishlist{% if is_manual %}/manual{% endif %}#{{ book_id }}"
       class="w-fit btn btn-ghost">&lt; Back to wishlist</a>
    <h1 class="text-3xl font-bold tracking-tight">
        Sources for {{ result.book.title }}
    </h1>
    {% if result.ok and not result.sources %}
        <div role="alert" class="alert">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>No results found for "{{ result.book.title }}" by
                {{ result.book.authors|join(",") }}. Might have to be looked up
            manually.</span>
        </div>
    {% elif not result.ok %}
        <div role="alert"
             class="alert"
             hx-get="{{ base_url }}/wishlist/sources/{{ book_id }}?only_body=true"
             hx-trigger="load"
             hx-target="#sources"
             hx-swap="outerHTML">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>Fetching sources from prowlarr
                <span class="ml-2 loading loading-dots"></span>
            </span>
        </div>
    {% endif %}
    {% if result.sources %}
        <p class="text-sm opacity-70 max-w-prose">
            Best first. Sources that fail the quality, seeder or title-match settings are listed last and are
            never downloaded automatically, but you can still send them to the download client by hand.
            <a preload class="link" href="{{ base_url }}/settings/download">Change the settings</a>
        </p>
    {% endif %}
    <div class="overflow-x-auto">
        <table class="table table-zebra table-pin-rows min-w-240">
            <thead>
                <tr>
                    <th>
                    </th>
                    <th>
                        title
                    </th>
                    <th>
                        author(s)
                    </th>
                    <th>
                        narrator(s)
                    </th>
                    <th>
                        indexer
                    </th>
                    <th>
                        flags
                    </th>
                    <th>
                        seed / leech (or grabs)
                    </th>
                    <th>
                        size (MB)
                    </th>
                    <th>
                        publish date
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for source, verdict in result.ranked %}
                    <tr class="text-xs lg:text-sm {% if loop.first and verdict and verdict.meets_bar %}bg-success/15{% endif %}">
                        <th>
                            {{ loop.index }}
                        </th>
                        <td>
                            {% if source.info_url %}
                                <a href="{{ source.info_url }}" class="link">{{ source.title }}</a>
                            {% else %}
                                {{ source.title }}
                            {% endif %}
                            {% if verdict %}
                                <div class="flex flex-wrap gap-x-2 text-xs mt-1">
                                    {% if verdict.meets_bar %}
                                        <span class="badge badge-sm badge-success"
                                              title="Clears the quality, seeder and title-match settings, so automatic downloads may pick it.">
                                            meets settings
                                        </span>
                                    {% else %}
                                        <span class="badge badge-sm badge-warning"
                                              title="Fails a check marked in red, so it is never downloaded automatically. You can still send it by hand.">
                                            fails settings
                                        </span>
                                    {% endif %}
                                    {% for check in verdict.checks %}
                                        <span class="{% if check.passed %}text-success{% elif check.blocking %}text-error{% else %}opacity-60{% endif %}"
                                              {% if check.hint %}title="{{ check.hint }}"{% endif %}>
                                            {%- if check.passed %}✓ {% elif check.passed is not none %}✗ {% endif -%}
                                            {{ check.label }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            {% if source.book_metadata.authors %}
                                {{ source.book_metadata.authors|join(", ") }}
                            {% endif %}
                        </td>
                        <td>
                            {% if source.book_metadata.narrators %}
                                {{ source.book_metadata.narrators|join(", ") }}
                            {% endif %}
                        </td>
                        <td>
                            {{ source.indexer }}
                        </td>
                        <td>
                            {{ source.indexer_flags|join(", ") }}
                        </td>
                        {% if source.protocol == "torrent" %}
                            <td>
                                {{ source.seeders }} / {{ source.leechers }}
                            </td>
                        {% else %}
                            <td>
                                {{ source.grabs }} grabs
                            </td>
                        {% endif %}
                        <td>
                            {{ source.size_MB }}
                        </td>
                        <td>
                            {{ source.publish_date.strftime("%d. %b %Y") }}
                        </td>
                        <td>
                            <label id="form-{{ loop.index }}"
                                   class="swap swap-flip"
                                   title="Send to download client">
                                <input id="checkbox-{{ loop.index }}"
                                       type="checkbox"
                                       hx-trigger="click"
                                       hx-target="this"
                                       hx-post="{{ base_url }}/wishlist/sources/{{ book_id }}"
                                       hx-include="#form-{{ loop.index }}"
                                       hx-on::after-request="if (event.detail.successful) this.disabled = true" />
                                <input type="hidden" name="indexer_id" value="{{ source.indexer_id }}" />
                                <input type="hidden" name="guid" value="{{ source.guid }}" />
                                <span class="swap-off">
                                    <icons.Download />
                                </span>
                                <span class="swap-on text-success">
                                    <icons.Checkmark />
                                </span>
                            </label>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
