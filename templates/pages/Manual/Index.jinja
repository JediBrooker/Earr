{#def
    user: DetailedUser,
    book: ManualBookRequest | None,
    auto_download: bool,
#}

<BaseLayout title="Manual Entry" user={{ user }}>
<div class="mx-auto w-full max-w-3xl flex flex-col items-center justify-center p-4 sm:p-6 lg:p-8 gap-4">
    <h1 class="text-3xl font-bold tracking-tight text-left w-full">
        Manual Request
    </h1>
    <Manual.Form book={{ book }} auto_download={{ auto_download }} />
</div>
</BaseLayout>
