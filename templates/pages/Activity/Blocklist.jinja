{#def
    user: DetailedUser,
    entries: list[BlocklistedRelease],
#}

<ActivityLayout user={{ user }} page="blocklist" title="Blocklist">
<p class="text-sm text-base-content/70">
    Releases that failed or were removed. Automatic downloads skip them and pick the next best release;
    you can still choose one by hand from a book's sources.
</p>
{% if not entries %}
    <div class="rounded-box border border-dashed border-base-content/20 p-10 text-center">
        <p class="font-medium">
            Nothing blocklisted
        </p>
        <p class="text-sm text-base-content/60">
            A release lands here when its download fails, or when you remove it from the queue with Blocklist.
        </p>
    </div>
{% else %}
    <div class="overflow-x-auto rounded-box border border-base-content/10">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        Release
                    </th>
                    <th class="hidden md:table-cell">
                        Why
                    </th>
                    <th class="hidden sm:table-cell">
                        When
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr class="blocklist-row">
                        <td>
                            <p class="font-semibold break-all line-clamp-2">
                                {{ entry.title }}
                            </p>
                            <p class="text-xs text-base-content/60">
                                {{ entry.book_title or "" }}{% if entry.indexer %} · {{ entry.indexer }}{% endif %}
                            </p>
                        </td>
                        <td class="hidden md:table-cell text-sm text-base-content/70">
                            {{ entry.reason or "" }}
                        </td>
                        <td class="hidden sm:table-cell text-sm whitespace-nowrap">
                            {{ entry.created_at.strftime("%-d %b %Y") }}
                        </td>
                        <td class="text-right">
                            <button class="btn btn-sm btn-ghost"
                                    hx-delete="{{ base_url }}/activity/blocklist/{{ entry.id }}"
                                    hx-target="closest .blocklist-row"
                                    hx-swap="delete">
                                Allow again
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
</ActivityLayout>
