{#def
    user: DetailedUser,
    users: Sequence[User],
    is_oidc: bool,
    limits: RequestLimitSettings,
#}

<SettingsLayout user={{ user }} page="users" title="Settings - Users">

{% if is_oidc %}
    <p class="text-error font-semibold">
        OpenID Connect is enabled. Users will be automatically created when they log in.
        If a user has a group assigned on the authentication server, it will override their group here.
    </p>
{% endif %}
<form id="create-user-form"
      class="flex flex-col gap-2"
      hx-post="{{ base_url }}/settings/users/hx-add"
      hx-target="#user-list"
      hx-on::after-request="if (event.detail.successful && event.detail.target?.id === 'user-list') this.reset()"
      hx-swap="outerHTML"
      hx-disabled-elt="#submit">
    <h2 class="text-lg">
        Create user
    </h2>
    <label for="username">
        Username
    </label>
    <input id="username"
           name="username"
           minlength="1"
           type="text"
           class="input w-full"
           required />
    <label for="password">
        Password
    </label>
    <input id="password"
           name="password"
           type="password"
           class="input w-full"
           required />
    <label for="select-group">
        Group
    </label>
    <select id="select-group" name="group" class="select w-full" required>
        <option value="untrusted" selected>
            Untrusted
        </option>
        <option value="trusted">
            Trusted
        </option>
        <option value="admin">
            Admin
        </option>
    </select>
    <button id="submit" class="btn btn-primary" type="submit">
        Create user
    </button>
</form>

<form class="flex flex-col gap-2 border-t border-base-200 pt-4 mt-4"
      hx-post="{{ base_url }}/settings/users/hx-limits"
      hx-swap="none">
    <h2 class="text-lg">
        Request limits
    </h2>
    <p class="text-xs opacity-60">
        How many books each person may request. 0 means no limit. Admins are never limited, and books
        requested because someone follows an author or series don't count. Set a different limit for
        one person in the list below.
    </p>
    <div class="grid gap-2 sm:grid-cols-3">
        <label class="flex flex-col gap-1">
            <span class="text-sm">Untrusted</span>
            <input type="number"
                   min="0"
                   name="untrusted"
                   value="{{ limits.untrusted }}"
                   class="input w-full" />
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-sm">Trusted</span>
            <input type="number"
                   min="0"
                   name="trusted"
                   value="{{ limits.trusted }}"
                   class="input w-full" />
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-sm">Per</span>
            <select name="period" class="select w-full">
                {% for value in ["day", "week", "month"] %}
                    <option value="{{ value }}"
                            {% if limits.period == value %}selected{% endif %}>{{ value | capitalize }}</option>
                {% endfor %}
            </select>
        </label>
    </div>
    <button class="btn w-fit">
        Save limits
    </button>
</form>

<Settings.Users.List user={{ user }} users={{ users }} />

</SettingsLayout>
