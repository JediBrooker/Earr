{#def
    user: DetailedUser,
    calendar: Calendar,
#}

<BaseLayout title="Calendar" user={{ user }}>
<div class="mx-auto flex w-full max-w-4xl flex-col gap-8 p-4 sm:p-6 lg:p-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">
            Calendar
        </h1>
        <p class="text-sm text-base-content/70">
            Requested books by release date. Pre-orders are searched for on the day they come out.
        </p>
    </div>

    <section class="flex flex-col gap-4">
        <h2 class="text-lg font-semibold">
            Coming up
        </h2>
        {% if not calendar.upcoming %}
            <div class="rounded-box border border-dashed border-base-content/20 p-8 text-center text-sm text-base-content/60">
                Nothing requested is still to come out. Request a book before its release date, or
                <a preload class="link" href="{{ base_url }}/following">follow an author</a>, and it shows up here.
            </div>
        {% endif %}
        {% for month_key, entries in calendar.upcoming | groupby("month_key") %}
            <div class="flex flex-col gap-2">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/60">
                    {{ entries[0].month_label }}
                </h3>
                <Calendar.Entries entries={{ entries }} user={{ user }} />
            </div>
        {% endfor %}
    </section>

    {% if calendar.recent %}
        <section class="flex flex-col gap-2">
            <h2 class="text-lg font-semibold">
                Out in the last 30 days
            </h2>
            <Calendar.Entries entries={{ calendar.recent }} user={{ user }} />
        </section>
    {% endif %}
</div>
</BaseLayout>
