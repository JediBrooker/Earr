{#def
    user: DetailedUser,
    report: HealthReport,
    database: str,
    config_dir: str,
#}

<SystemLayout user={{ user }} page="status">
<div class="flex flex-col gap-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <p class="text-sm text-base-content/70">
            Whether everything Earr depends on is reachable and set up correctly.
        </p>
        <button class="btn btn-sm"
                hx-get="{{ base_url }}/system/hx-checks?refresh=true"
                hx-target="#health-checks"
                hx-swap="outerHTML"
                hx-disabled-elt="this">
            Check again
        </button>
    </div>

    <System.Checks report={{ report }} />

    <section class="flex flex-col gap-3">
        <h2 class="text-lg font-semibold">
            About
        </h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-2 text-sm">
            <dt class="text-base-content/60">
                Version
            </dt>
            <dd class="font-mono">
                {{ version }}
            </dd>
            <dt class="text-base-content/60">
                Database
            </dt>
            <dd>
                {{ database }}
            </dd>
            <dt class="text-base-content/60">
                Config folder
            </dt>
            <dd class="font-mono break-all">
                {{ config_dir }}
            </dd>
            <dt class="text-base-content/60">
                Base URL
            </dt>
            <dd class="font-mono">
                {{ base_url or "/" }}
            </dd>
        </dl>
    </section>
</div>
</SystemLayout>
