{#def
    user: DetailedUser,
    title: str,
    page: str,
#}

<BaseLayout title={{ title }} user={{ user }}>
<div class="mx-auto flex w-full max-w-3xl flex-col gap-8 px-4 py-6 pb-16 sm:px-6 lg:px-8">
    {% if user.is_admin() %}
        {# on large screens these live in the sidebar, under Settings #}
        <div role="tablist"
             class="tabs tabs-box flex-nowrap overflow-x-auto [scrollbar-width:none] lg:hidden">
            <a preload
               href="{{ base_url }}/settings/account"
               role="tab"
               class="tab {% if page=='account' %}tab-active{% endif %}">Account</a>
            <a preload
               href="{{ base_url }}/settings/users"
               role="tab"
               class="tab {% if page=='users' %}tab-active{% endif %}">Users</a>
            <a preload
               href="{{ base_url }}/settings/prowlarr"
               role="tab"
               class="tab {% if page=='prowlarr' %}tab-active{% endif %}">Prowlarr</a>
            <a preload
               href="{{ base_url }}/settings/indexers"
               role="tab"
               class="tab {% if page=='indexers' %}tab-active{% endif %}">Indexers</a>
            <a preload
               href="{{ base_url }}/settings/download"
               role="tab"
               class="tab {% if page=='download' %}tab-active{% endif %}">Download</a>
            <a preload
               href="{{ base_url }}/settings/library"
               role="tab"
               class="tab {% if page=='library' %}tab-active{% endif %}">Library</a>
            <a preload
               href="{{ base_url }}/settings/audiobookshelf"
               role="tab"
               class="tab {% if page=='audiobookshelf' %}tab-active{% endif %}">Audiobookshelf</a>
            <a preload
               href="{{ base_url }}/settings/notifications"
               role="tab"
               class="tab {% if page=='notifications' %}tab-active{% endif %}">Notifications</a>
            <a preload
               href="{{ base_url }}/settings/security"
               role="tab"
               class="tab {% if page=='security' %}tab-active{% endif %}">Security</a>
        </div>
    {% endif %}

    {{ content }}

    {% if version %}
        <footer class="border-t border-base-content/10 pt-4 text-xs text-base-content/60">
            Earr <span class="font-mono">{{ version }}</span>
            ·
            <button class="link" onclick="changelog_modal.showModal()">
                Changelog
            </button>
        </footer>
        <dialog id="changelog_modal" class="modal">
            <div class="modal-box changelog max-h-4/5">
                {{ changelog | safe }}
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>
                    close
                </button>
            </form>
        </dialog>
    {% endif %}
</div>

</BaseLayout>
