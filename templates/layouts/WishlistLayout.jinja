{#def
    user: DetailedUser,
    title: str,
    page: str,
    counts: WishlistCounts,
#}

<BaseLayout title={{ title }} user={{ user }}>
<div class="flex w-full flex-col gap-4 p-4 sm:p-6 lg:p-8">
    <h1 class="text-3xl font-bold tracking-tight">
        Wishlist
    </h1>

    <Wishlist.Tablist page={{ page }} counts={{ counts }} />

    {{ content }}
</div>
</BaseLayout>
