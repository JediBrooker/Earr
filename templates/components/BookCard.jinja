{#def
    book_with_requests: AudiobookWithRequests,
    auto_start_download: bool,
    region: audible_region_type,
    user: DetailedUser,
#}

{% set book = book_with_requests.book %}
{% set already_requested = book_with_requests.already_requested %}
{% set series_label = (book.series or "") ~ (" #" ~ book.series_position if book.series and book.series_position else "") %}

<div class="book-card flex flex-col">
    <div class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-md overflow-hidden shadow shadow-black items-center justify-center flex">
        {% if book.cover_image %}
            <img class="object-cover w-full h-full cursor-pointer hover:scale-110 transition-transform duration-500 ease-in-out"
                 height="128"
                 width="128"
                 src="{{ book.cover_image }}"
                 alt="{{ book.title }}"
                 title="Click to enlarge"
                 onclick="bookCoverModal{{ book.asin }}.showModal()" />
            <dialog id="bookCoverModal{{ book.asin }}" class="modal book-cover-modal">
                <div class="modal-box">
                    <img src="{{ book.cover_image }}" alt="{{ book.title }}" />
                </div>
                <form method="dialog" class="modal-backdrop">
                    <button aria-label="Close">close</button>
                </form>
            </dialog>
        {% else %}
            <icons.PhotoOff />
        {% endif %}
        <!-- Request Button -->
        <button class="absolute top-0 right-0 rounded-none rounded-bl-md btn-sm btn btn-square items-center justify-center flex {% if book.downloaded or already_requested %}btn-ghost bg-success text-neutral/20{% else %}btn-primary{% endif %}"
                hx-post="{{ base_url }}/request/hx-add/{{ book.asin }}"
                hx-vals='{"region": "{{ region }}"}'
                hx-disabled-elt="this"
                hx-target="closest .book-card"
                hx-swap="outerHTML"
                hx-on:click="this.disabled = true;"
                {% if book.downloaded or already_requested %}disabled{% endif %}>
            {% if book.downloaded or already_requested %}
                <span>
                    <icons.Checkmark />
                </span>
            {% else %}
                {% if auto_start_download and user.can_download() %}
                    <span>
                        <icons.Download />
                    </span>
                {% else %}
                    <span>
                        <icons.Plus />
                    </span>
                {% endif %}
            {% endif %}
        </button>
    </div>
    <!-- Book Info -->
    {% if book.asin %}
        <a class="text-sm text-primary font-bold pt-1 line-clamp-2"
           title="{{ book.title }}"
           target="_blank"
           href="https://audible{{ audible_regions[region] }}/pd/{{ book.asin }}?ipRedirectOverride=true">
            {{ book.title }}
        </a>
    {% else %}
        <div class="text-sm text-primary font-bold pt-1 line-clamp-2"
             title="{{ book.title }}">
            {{ book.title }}
        </div>
    {% endif %}
    {% if book.series %}
        <div class="text-xs font-semibold text-secondary line-clamp-1"
             title="{{ series_label }}">
            {{ series_label }}
        </div>
    {% endif %}
    {# Audible subtitles are often just "<series>, Book 1" or the series name alone, which the series line already says #}
    {% set repeats_series = book.series and book.subtitle and (book.series | lower in book.subtitle | lower or book.subtitle | lower in book.series | lower) %}
    {% if book.subtitle and not repeats_series %}
        <div class="opacity-60 font-semibold text-xs line-clamp-1"
             title="{{ book.subtitle }}">
            {{ book.subtitle }}
        </div>
    {% endif %}
    <div class="text-xs font-semibold line-clamp-1"
         title="Authors: {{ book.authors | join(", ") }}">
        {% for author in book.authors[:2] %}
            <a href="{{ base_url }}/search?q={{ author | urlencode }}"
               title="Search for {{ author }}"
               class="hover:underline">
                {{ author }}
            {{- "," if loop.index < book.authors | length and loop.index < 2 else "" -}}</a>
        {% endfor %}
        {% if book.authors | length > 2 %}
            <span class="opacity-60">+{{ book.authors | length - 2 }} more</span>
        {% endif %}
    </div>
    {% if book.narrators %}
        <div class="text-xs line-clamp-1"
             title="Narrators: {{ book.narrators | join(", ") }}">
            <span class="opacity-60">Read by</span>
            {% for narrator in book.narrators[:2] %}
                <a href="{{ base_url }}/search?q={{ narrator | urlencode }}"
                   title="Search for {{ narrator }}"
                   class="hover:underline">
                    {{ narrator }}
                {{- "," if loop.index < book.narrators | length and loop.index < 2 else "" -}}</a>
            {% endfor %}
            {% if book.narrators | length > 2 %}
                <span class="opacity-60">+{{ book.narrators | length - 2 }} more</span>
            {% endif %}
        </div>
    {% endif %}
    <!-- Release year and runtime -->
    <div class="text-xs opacity-60 mt-1">
        {{ book.release_date.year }}
        {%- if book.runtime_length_min %} · {{ book.runtime_length_hrs }}h{% endif %}
    </div>
</div>
